{
  "$id": "https://amc.dev/schema/agent.amc.json",
  "title": "AMC agent manifest (amc.yaml)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(skill|agent|command|workflow)\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "default": "0.1.0",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1536
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "compat": {
      "type": "object",
      "properties": {
        "exclude": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "overrides": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "raw": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "additionalProperties": {}
          }
        }
      }
    },
    "kind": {
      "type": "string",
      "const": "agent"
    },
    "model": {
      "type": "object",
      "properties": {
        "preferred": {
          "type": "string",
          "enum": [
            "inherit",
            "fast",
            "balanced",
            "powerful"
          ]
        },
        "fallback": {
          "type": "string",
          "enum": [
            "inherit",
            "fast",
            "balanced",
            "powerful"
          ]
        }
      },
      "required": [
        "preferred"
      ]
    },
    "tools": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(:[a-z0-9*_.-]+)?$"
          }
        },
        "deny": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(:[a-z0-9*_.-]+)?$"
          }
        }
      }
    },
    "skills": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^(skill|agent|command|workflow)\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "mode": {
            "default": "on-demand",
            "type": "string",
            "enum": [
              "on-demand",
              "always"
            ]
          }
        },
        "required": [
          "ref"
        ]
      }
    },
    "delegatesTo": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^(skill|agent|command|workflow)\\.[a-z0-9]+(-[a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "id",
    "name",
    "slug",
    "description",
    "kind"
  ]
}
